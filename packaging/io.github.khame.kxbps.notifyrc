# KNotification event configuration for KXbps.
#
# The event id is the one `Notifier.qml` sends (`updates-available`). Without
# this file KNotification logs "No event config could be found for event id"
# and the popup has no configured urgency or icon. The title and text are set
# at runtime, so `Name` and `Comment` are the fallback the notification
# settings page shows.
[Event/updates-available]
Name=Updates available
Comment=Packages can be updated
IconName=system-software-update
Urgency=Normal
