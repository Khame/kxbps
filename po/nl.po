msgstr "De wachtrij wijzigt het systeem niet."

#: kxbps-qt/qml/views/HelpView.qml:88
msgid ""
"The queue, the preferences and the chosen mirror are kept in ~/.local/share/"
"kxbps/."
msgstr ""
"De wachtrij, de voorkeuren en de gekozen mirror staan in ~/.local/share/"
"kxbps/."

